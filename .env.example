# =========================
# 🔐 DISCORD
# =========================
DISCORD_TOKEN=ton_token_discord

# =========================
# 🔄 AUTO UPDATE (Optionnel)
# =========================
# Activer l'auto-update (true/false)
AUTO_UPDATE=true

# Intervalle de vérification en millisecondes (défaut: 300000 = 5 minutes)
AUTO_UPDATE_INTERVAL=300000

# Dépôt GitHub (format: owner/repo)
GITHUB_REPO=Hiver-protect/LvProtect

# Branche GitHub (défaut: main)
GITHUB_BRANCH=main

# =========================
# 📝 LOGS (Optionnel)
# =========================
# ID du salon Discord pour les logs
LOG_CHANNEL_ID=